# Public teaching reads require the existing Supabase configuration.
# Copy to .env.local only when intentionally configuring a local/hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for public feedback submission only; keep in ignored local/server secrets.
# Never prefix privileged keys with NEXT_PUBLIC_; never put them in client code.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Use one of the two privileged key variables above, never a NEXT_PUBLIC_ variable.
# Comma-separated exact origins, without a trailing slash. Add deployed HTTPS origins deliberately.
FEEDBACK_ALLOWED_ORIGINS=
# Database passwords and CLI access tokens belong in secure local tooling, not this file.
