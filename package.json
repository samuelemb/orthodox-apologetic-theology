{
  "name": "orthodox-apologetic-theology",
  "version": "0.1.0",
  "description": "Phase 1 public foundation for Orthodox Apologetic Theology",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local --no-seed",
    "db:test": "supabase test db --local",
    "db:seed:generate": "node scripts/generate-development-seed.cjs",
    "test:foundation": "node scripts/phase-3-foundation-check.cjs",
    "db:inspect:hosted": "node scripts/hosted/preflight.mjs",
    "db:test:hosted": "node scripts/hosted/authorization.mjs",
    "test:admin-auth": "node scripts/hosted/admin-auth-test.mjs",
    "test:admin-ui": "node scripts/admin-ui-public-check.mjs",
    "test:teaching-validation": "node scripts/phase-4b-validation.mjs",
    "test:teaching-editor": "node scripts/hosted/teaching-editor-test.mjs",
    "test:teaching-editor-ui": "node scripts/hosted/teaching-editor-ui-test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.9.0"
}
